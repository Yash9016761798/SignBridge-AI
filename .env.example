# ============================================================
# SignBridge AI - Deployment Environment Variables
# ============================================================
# Copy this file to .env and customize as needed.
# ============================================================

# ------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------
# Port for the frontend web server
WEB_PORT=3000

# AI Service URL (from browser perspective - use localhost)
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# App metadata
NEXT_PUBLIC_APP_NAME=SignBridge AI
NEXT_PUBLIC_APP_ENV=production

# Backend API URL (optional - for full stack)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Firebase (optional - for auth features)
# NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ------------------------------------------------------------
# AI Service (FastAPI + PyTorch)
# ------------------------------------------------------------
# Port for the AI inference service
AI_PORT=8000

# Model configuration
MODEL_CHECKPOINT=experiments/representative/checkpoints/best.pt
VOCAB_PATH=experiments/representative/vocabulary.json
MODEL_VERSION=1.0.0

# AI service settings
SIGNBRIDGE_DEBUG=false
SIGNBRIDGE_LOG_LEVEL=INFO

# Device: "cpu" for most deployments, "cuda" for GPU
# SIGNBRIDGE_DEVICE=cpu

# ------------------------------------------------------------
# Demo Mode
# ------------------------------------------------------------
# Enable demo mode to allow pose upload/replay without webcam
# When true, the AI service serves sample sequences
DEMO_MODE=false

# ------------------------------------------------------------
# Backend API (Optional - only needed for full stack)
# ------------------------------------------------------------
# BACKEND_PORT=3001
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signbridge_ai
